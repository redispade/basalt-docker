# Copy this file to .env and fill in the values. .env is never committed.

# Required. The server refuses to start without it. Use a long random string:
#   openssl rand -hex 32
BASALT_API_KEY=change-me

# Owner of this workspace, as seen by the container. Check with: id -u / id -g
LOCAL_UID=1000
LOCAL_GID=1000

# Upstream branch or tag to build.
BASALT_REF=main

# Parallel compile jobs. 16 = one per physical core; 32 = all logical threads.
BUILD_JOBS=16

#define your models volume here. This is where you should put your .basalt model files. The container will mount this path to /models.
MODELS_VOLUME=./models